---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="About | Rostyslav Kozyk"
    description="About Rostyslav Kozyk and this engineering knowledge base."
>
    <main class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider">About</p>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">About me</h1>

        <div class="prose mt-10 max-w-none">
            <p>
                I am a software engineer focused on test automation and software
                architecture.
            </p>

            <p>
                This website documents the projects I build, the technologies I
                use, and the engineering decisions behind them.
            </p>

            <p>
                My goal is to turn practical software projects into reusable
                learning material.
            </p>
        </div>
    </main>
</BaseLayout>
