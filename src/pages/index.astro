---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/home/Hero.astro";
import FeaturedProject from "../components/home/FeaturedProject.astro";
import LatestArticles from "../components/home/LatestArticles.astro";
import AboutPreview from "../components/home/AboutPreview.astro";

import { getFeaturedProject, getLatestArticles } from "../utils/content";

const featuredProject = await getFeaturedProject();
const latestArticles = await getLatestArticles(3);
---

<BaseLayout
	title="Rostyslav Kozyk | Software Engineer"
	description="Software engineering projects, architecture decisions and technical articles."
>
	<main class="mx-auto max-w-5xl px-6">
		<Hero />

		{featuredProject && <FeaturedProject project={featuredProject} />}

		<LatestArticles articles={latestArticles} />

		<AboutPreview />
	</main>
</BaseLayout>
