---
import type { CollectionEntry } from "astro:content";

import ArticleCard from "../article/ArticleCard.astro";

interface Props {
  articles: CollectionEntry<"articles">[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="mt-20 border-t pt-12">
      <header class="mb-8">
        <p
          class="mb-2 text-sm font-semibold uppercase tracking-wider"
        >
          Knowledge Base
        </p>

        <h2 class="text-3xl font-bold tracking-tight">
          Related Articles
        </h2>

        <p class="mt-3 max-w-2xl leading-relaxed">
          Articles explaining the architecture,
          implementation decisions and lessons learned
          while building this project.
        </p>
      </header>

      <div class="space-y-8">
        {
          articles.map((article) => (
            <ArticleCard article={article} />
          ))
        }
      </div>
    </section>
  )
}