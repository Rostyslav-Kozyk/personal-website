---
import TagLink from "./TagLink.astro";

interface Props {
    tags: string[];
}

const { tags } = Astro.props;
---

{
    tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
                <TagLink tag={tag} />
            ))}
        </div>
    )
}
