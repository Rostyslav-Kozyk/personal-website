---
import { normalizeTag } from "../../utils/content";

interface Props {
    tag: string;
}

const { tag } = Astro.props;

const href = `/articles/tag/${normalizeTag(tag)}`;
---

<a
    href={href}
    class="rounded-md border border-border-default bg-surface px-2.5 py-1 text-sm text-text-secondary transition-colors hover:bg-surface-hover hover:text-text-primary"
>
    {tag}
</a>
