---
import type { CollectionEntry } from "astro:content";

import { formatDate } from "../../utils/dates";

import TagLink from "./TagLink.astro";

interface Props {
    article: CollectionEntry<"articles">;
}

const { article } = Astro.props;

const publishedAt = formatDate(article.data.publishedAt);
---

<article>
    <time datetime={article.data.publishedAt.toISOString()} class="text-sm">
        {publishedAt}
    </time>

    <h2 class="mt-2 text-2xl font-semibold tracking-tight">
        <a href={`/articles/${article.id}`} class="hover:underline">
            {article.data.title}
        </a>
    </h2>

    <p class="mt-3 max-w-3xl leading-relaxed">
        {article.data.description}
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
        {article.data.tags.map((tag) => <TagLink tag={tag} />)}
    </div>

    <a
        href={`/articles/${article.id}`}
        class="mt-5 inline-block text-sm font-semibold hover:underline"
    >
        Read article
    </a>
</article>
