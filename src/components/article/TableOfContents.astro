---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;

const visibleHeadings = headings.filter(
    ({ depth }) => depth === 2 || depth === 3,
);
---

{
    visibleHeadings.length > 0 && (
        <aside class="rounded-xl border border-border-default bg-surface p-5">
            <p class="text-sm font-semibold uppercase tracking-wider">
                On this page
            </p>

            <nav aria-label="Table of contents" class="mt-4">
                <ul class="space-y-2">
                    {visibleHeadings.map((heading) => (
                        <li
                            class:list={[
                                {
                                    "pl-4": heading.depth === 3,
                                },
                            ]}
                        >
                            <a
                                href={`#${heading.slug}`}
                                class="text-sm text-text-secondary transition-colors hover:text-accent"
                            >
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </aside>
    )
}
