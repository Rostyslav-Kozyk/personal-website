---
import type { CollectionEntry } from "astro:content";

interface Props {
    previous?: CollectionEntry<"articles">;
    next?: CollectionEntry<"articles">;
}

const { previous, next } = Astro.props;
---

{
    (previous || next) && (
        <nav
            aria-label="Article navigation"
            class="mt-16 grid gap-4 border-t border-border-default pt-8 sm:grid-cols-2"
        >
            <div>
                {previous && (
                    <a
                        href={`/articles/${previous.id}`}
                        class="block rounded-xl border border-border-default bg-surface p-5 transition-colors hover:bg-surface-hover"
                    >
                        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">
                            Previous article
                        </span>

                        <span class="mt-2 block font-semibold">
                            ← {previous.data.title}
                        </span>
                    </a>
                )}
            </div>

            <div>
                {next && (
                    <a
                        href={`/articles/${next.id}`}
                        class="block rounded-xl border border-border-default bg-surface p-5 text-right transition-colors hover:bg-surface-hover"
                    >
                        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">
                            Next article
                        </span>

                        <span class="mt-2 block font-semibold">
                            {next.data.title} →
                        </span>
                    </a>
                )}
            </div>
        </nav>
    )
}
