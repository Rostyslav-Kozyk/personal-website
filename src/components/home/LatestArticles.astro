---
import type { CollectionEntry } from "astro:content";

import ArticleCard from "../article/ArticleCard.astro";

interface Props {
    articles: CollectionEntry<"articles">[];
}

const { articles } = Astro.props;
---

{
    articles.length > 0 && (
        <section class="border-t border-border-default py-16 sm:py-20">
            <header class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-wider">
                        Knowledge Base
                    </p>

                    <h2 class="mt-2 text-3xl font-bold tracking-tight">
                        Latest Articles
                    </h2>

                    <p class="mt-3 max-w-2xl leading-relaxed">
                        Technical notes about architecture, test automation and
                        software engineering decisions.
                    </p>
                </div>

                <a
                    href="/articles"
                    class="text-sm font-semibold text-accent hover:text-accent-hover"
                >
                    View all articles →
                </a>
            </header>

            <div class="divide-y">
                {articles.map((article) => (
                    <div class="py-8 first:pt-0 last:pb-0">
                        <ArticleCard article={article} />
                    </div>
                ))}
            </div>
        </section>
    )
}
