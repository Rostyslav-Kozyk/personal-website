---
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border-default">
    <div
        class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-10 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
        <p>
            © {currentYear} Rostyslav Kozyk
        </p>

        <div class="flex gap-5">
            <a
                href="https://github.com/Rostyslav-Kozyk"
                target="_blank"
                rel="noreferrer"
                class="hover:opacity-70"
            >
                GitHub
            </a>

            <a href="/projects" class="hover:opacity-70"> Projects </a>

            <a href="/articles" class="hover:opacity-70"> Articles </a>
        </div>
    </div>
</footer>
