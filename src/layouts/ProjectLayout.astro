---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "./BaseLayout.astro";

import { formatMonthYear } from "../utils/dates";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const createdAt = formatMonthYear(project.data.createdAt);
---

<BaseLayout
    title={`${project.data.title} | Rostyslav Kozyk`}
    description={project.data.description}
>
    <main class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
        <header class="mb-12">
            <a href="/projects" class="text-sm font-medium hover:underline">
                ← All projects
            </a>

            <p class="mt-8 text-sm font-semibold uppercase tracking-wider">
                Project
            </p>

            <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
                {project.data.title}
            </h1>

            <p class="mt-5 max-w-3xl text-xl leading-relaxed">
                {project.data.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
                {
                    project.data.technologies.map((technology) => (
                        <span class="rounded-md border px-3 py-1 text-sm font-medium">
                            {technology}
                        </span>
                    ))
                }
            </div>

            <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm">
                <div>
                    <dt class="font-semibold">Status</dt>

                    <dd class="mt-1 capitalize">
                        {project.data.status}
                    </dd>
                </div>

                <div>
                    <dt class="font-semibold">Started</dt>

                    <dd class="mt-1">
                        {createdAt}
                    </dd>
                </div>
            </dl>

            <div class="mt-8">
                <a
                    href={project.data.github}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex rounded-lg border px-4 py-2 text-sm font-semibold hover:opacity-70"
                >
                    View repository on GitHub
                </a>
            </div>
        </header>

        <article class="prose max-w-none dark:prose-invert">
            <slot />
        </article>

        <slot name="after-content" />
    </main>
</BaseLayout>
